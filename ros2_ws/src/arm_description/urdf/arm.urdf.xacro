<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="arm">


<!-- <xacro:property name="base_length" value="0.1500"/> -->

<link name="world"/>


<link name="base_link">

    <visual>
        <geometry>
            <mesh filename="package://arm_description/meshes/base.stl"
                  scale="0.001 0.001 0.001"/>
        </geometry>

        <material name="white">
            <color rgba="1 1 1 1"/>
        </material>
    </visual>

    <collision>
     <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <mesh filename="package://arm_description/meshes/base.stl"
                  scale="0.001 0.001 0.001"/>
        </geometry>
    </collision>

    <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 0"/>
        <inertia
            ixx="0.01"
            ixy="0"
            ixz="0"
            iyy="0.01"
            iyz="0"
            izz="0.01"/>
    </inertial>

</link>


<joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>

    <!-- Change these values to move or rotate the entire robot -->
    <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
</joint>


<link name="central_axis_link">

    <visual>

        <geometry>
            <mesh filename="package://arm_description/meshes/central_axis.stl"
                  scale="0.001 0.001 0.001"/>
        </geometry>

        <material name="white">
            <color rgba="1 1 1 1"/>
        </material>

    </visual>


    <collision>

        <geometry>
            <mesh filename="package://arm_description/meshes/central_axis.stl"
                  scale="0.001 0.001 0.001"/>
        </geometry>

    </collision>

</link>


<joint name="servo_rotation_joint" type="revolute">

    <parent link="base_link"/>
    <child link="central_axis_link"/>

    <origin xyz="0 0 0"
            rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
        lower="-2.6"
        upper="-.4"
        effort="2"
        velocity="5"/>

</joint>


