<link name="servo_link">

    <visual>

        <geometry>
            <cylinder radius="0.02"
                      length="0.02"/>
        </geometry>

        <material name="black">
            <color rgba="0 1 0 1"/>
        </material>

    </visual>

</link>


<joint name="servo_rotation_joint" type="revolute">

    <parent link="lidar_base_link"/>
    <child link="servo_link"/>

    <origin xyz=".04 .125 .0875"
            rpy="-1.5708 3.14159 0"/>

    <axis xyz="0 0 1"/>

    <limit
        lower=".52"
        upper="2.62"
        effort="2"
        velocity="5"/>

</joint>


<link name="top_link">

    <visual>

        <geometry>
            <mesh filename="package://my_robot_description/meshes/top.stl"
                  scale="0.001 0.001 0.001"/>
        </geometry>

        <material name="gray">
            <color rgba=".5 .5 .5 1"/>
        </material>

    </visual>

</link>

<joint name="top_joint" type="fixed">

    <parent link="servo_link"/>
    <child link="top_link"/>

    <origin xyz="-.0375 .085 -.125"
            rpy="1.5708 0 0"/>

</joint>


<link name="lidar_link">
    <visual>
        <geometry>
            <box size="0.02125 0.035 0.012"/>
        </geometry>

        <origin xyz="0 0 0"/>

        <material name="black">
            <color rgba="0 0 0 1"/>
        </material>
    </visual>
</link>

<joint name="lidar_joint" type="fixed">

    <parent link="top_link"/>
