<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="my_robot">


<xacro:property name="base_length" value="0.1500"/>
<xacro:property name="base_width"  value="0.1250"/>
<xacro:property name="base_height" value="0.0508"/>

<xacro:property name="wheel_radius" value="0.0205"/>
<xacro:property name="wheel_width"  value="0.017"/>

<xacro:property name="wheel_x" value="0.0225"/>
<xacro:property name="left_wheel_y" value="0.1335"/>
<xacro:property name="right_wheel_y" value="-0.0085"/>


<link name="base_link">

    <visual>
        <geometry>
            <mesh filename="package://my_robot_description/meshes/base.stl"
                  scale="0.001 0.001 0.001"/>
        </geometry>

        <material name="white">
            <color rgba="1 1 1 1"/>
        </material>
    </visual>

    <collision>
        <geometry>
            <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
    </collision>

    <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 0"/>
        <inertia
            ixx="0.01"
            ixy="0"
            ixz="0"
            iyy="0.01"
            iyz="0"
            izz="0.01"/>
    </inertial>

</link>


<xacro:macro name="wheel" params="name x y">

    <link name="${name}">

        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}"
                          length="${wheel_width}"/>
            </geometry>

            <origin rpy="1.5708 0 0"/>

            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>

        <!-- Rotation marker -->
        <visual>
            <geometry>
                <box size="0.006 0.006 0.025"/>
            </geometry>

            <origin xyz="${wheel_radius + 0.004} 0 0"
                    rpy="0 0 0"/>

            <material name="${name}_red_marker">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>


        <collision>

            <geometry>
                <cylinder radius="${wheel_radius}"
                          length="${wheel_width}"/>
            </geometry>

            <origin rpy="1.5708 0 0"/>

        </collision>


    </link>

    <joint name="${name}_joint" type="continuous">

        <parent link="base_link"/>
        <child link="${name}"/>

        <origin xyz="${x} ${y} -0.0105"
                rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>

</xacro:macro>


<xacro:wheel
    name="left_wheel"
    x="${wheel_x}"
    y="${left_wheel_y}"/>

<xacro:wheel
    name="right_wheel"
    x="${wheel_x}"
    y="${right_wheel_y}"/>


<link name="caster_link">

    <visual>
        <geometry>
            <sphere radius="0.015"/>
        </geometry>

        <material name="gray">
            <color rgba=".5 .5 .5 1"/>
        </material>
    </visual>


    <collision>
        <geometry>
            <sphere radius="0.015"/>
        </geometry>
    </collision>


</link>

<joint name="caster_joint" type="fixed">

    <parent link="base_link"/>
    <child link="caster_link"/>

    <origin xyz="0.140 0.0625 -0.01"
            rpy="0 0 0"/>

</joint>


<link name="imu_link">

    <visual>

        <geometry>
            <box size="0.01 0.01 0.005"/>
        </geometry>

        <material name="light blue">
            <color rgba="0 0 .25 1"/>
        </material>

    </visual>


</link>


<joint name="imu_joint" type="fixed">

    <parent link="base_link"/>
    <child link="imu_link"/>

    <origin xyz="0.02 0.12 0.0459"
            rpy="0 0 0"/>

</joint>


<link name="camera_link">

    <visual>

        <geometry>
            <box size="0.015 0.015 0.015"/>
        </geometry>

        <material name="green">
            <color rgba=".2 .2 .2 1"/>
        </material>

    </visual>

</link>


<joint name="camera_joint" type="fixed">

    <parent link="base_link"/>
    <child link="camera_link"/>

    <origin xyz="0.142 .02 0.035"
            rpy="0 0 0"/>

</joint>


<link name="base_cover_link">

    <visual>
        <geometry>
            <mesh filename="package://my_robot_description/meshes/base_cover.stl"
                  scale="0.001 0.001 0.001"/>
        </geometry>

        <material name="white">
            <color rgba="1 1 1 .25"/>
        </material>
    </visual>

</link>


<joint name="base_cover_joint" type="fixed">

    <parent link="base_link"/>
    <child link="base_cover_link"/>

    <origin xyz="0 0 0.050"
            rpy="0 0 0"/>

</joint>

<link name="rplidar_link">
    <visual>
        <geometry>
            <mesh filename="package://my_robot_description/meshes/rplidar.stl"
                  scale="0.001 0.001 0.001"/>
        </geometry>

        <material name="black">
            <color rgba="0 0 0 .75"/>
        </material>

    </visual>
</link>


<joint name="rplidar_joint" type="fixed">

    <parent link="base_cover_link"/>
    <child link="rplidar_link"/>

    <origin xyz=".12 .07 .002"
            rpy="0 0 0"/>

</joint>

<link name="laser"/>

<joint name="laser_joint" type="fixed">
    <parent link="rplidar_link"/>
    <child link="laser"/>

    <origin xyz="0 0 0"
            rpy="0 0 0"/>
</joint>

